{
  "name": "aledha-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"node server/index.js\" \"vite\"",
    "client": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "tunnel": "node scripts/tunnel.js",
    "host": "concurrently -n \"SERVER,TUNNEL\" -c \"magenta,green\" \"node server/index.js\" \"node scripts/tunnel.js\"",
    "start:tunnel": "npm run host"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "audio-decode": "^3.12.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "music-metadata": "^11.16.1",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^6.2.0"
  }
}
